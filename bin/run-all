#!/bin/bash
# Check that the rows agree, then time them: results/bench.json and results/RESULTS.md.
#   bin/run-all [--runs N]   (default 5)
set -euo pipefail
source "$(dirname "$0")/env.sh"
RUNS=5
[ "${1:-}" = --runs ] && RUNS=$2
B=$OUT/bin
cd "$ROOT"
log "conformance: goose against alacritty, whole input and in 7-byte chunks"
python3 -I tests/diff.py "$B/alacritty_row" "$B/vt_goose" -- "$OUT"/cases/* "$INPUTS"/* | tail -1
python3 -I tests/diff.py --chunk 7 "$B/alacritty_row" "$B/vt_goose" -- "$OUT"/cases/* "$INPUTS"/* | tail -1
log "conformance: libvterm against alacritty"
python3 -I tests/diff.py "$B/alacritty_row" "$B/libvterm_row" -- "$OUT"/cases/* "$INPUTS"/* | grep -v '^    \|^  ' > results/libvterm-diff.txt || true
tail -1 results/libvterm-diff.txt
log "timing: $RUNS runs, pinned to CPU ${CPU:-2}"
python3 -I scripts/bench.py --out results/bench.json --runs "$RUNS" --cpu "${CPU:-2}" \
  alacritty="$B/alacritty_row" libvterm="$B/libvterm_row" goose="$B/vt_goose" -- "$INPUTS"/*
python3 -I scripts/table.py results/bench.json > results/RESULTS.md
log "wrote results/RESULTS.md"
